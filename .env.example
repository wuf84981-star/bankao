# ============================================================
# 伴考 · 环境变量模板（复制为 .env 后填写；.env 永不进 git）
# 密钥值只待在这份文件里；改完 .env 需 docker compose up -d 重建容器才生效
# （env 文件只在建容器时读一次）
# ============================================================

# ── 必填五把钥匙 ──
# 对话大脑（默认模型；聊天里可换的 DeepSeek 型号也吃这把）：platform.deepseek.com
DEEPSEEK_API_KEY=
# 图片 OCR + 向量点火（通义型号同款）：阿里云百炼 bailian.console.aliyun.com
DASHSCOPE_API_KEY=
# 注册/找回验证码邮件（465 端口 SSL）：任意邮箱 SMTP 授权码
SMTP_USER=
SMTP_PASS=
# 户主邮箱——此邮箱注册者直升管理员
BANKAO_ADMIN_EMAIL=

# ── 数据库口令（compose 与 alembic 共用；首次部署请改成自己的强口令，
#    并在 db 容器里 ALTER USER 对齐，README 有步骤）──
DB_PASSWORD=dev_only_123

# ── 通道内部票（局域网值；NapCat 面板里配的 token 要与 ONEBOT_API_TOKEN 同串）──
ONEBOT_API_TOKEN=bankao-local-push
WEBUI_TOKEN=bankao-napcat-ui

# ── JWT 签名钥匙（留空=用代码内置开发值，公网部署务必配上随机长串）──
BANKAO_JWT_SECRET=

# ── 可选：不配不坏，对应功能会如实自曝缺钥匙 ──
# 联网兜底搜索（聊天里地球开关打开才会用到）：app.tavily.com 免费注册
TAVILY_API_KEY=
# 智谱 GLM 三个型号（聊天菜单换到 GLM 才会用到）：open.bigmodel.cn
ZHIPU_API_KEY=

# ── 可选覆盖（不填走代码/compose 默认值）──
# SMTP_HOST=
# SMTP_PORT=
# BOT_QQ=
